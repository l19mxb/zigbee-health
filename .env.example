# Use a new private value when deploying. The application refuses LAN hosting
# without a password of at least 12 characters. Do not commit the real .env.
ZIGBEE_HEALTH_PASSWORD=

# Keep loopback binding for local use. Set both values for a trusted LAN.
BIND_ADDRESS=127.0.0.1
PUBLIC_HOST=localhost
APP_PORT=18920
TZ=UTC
